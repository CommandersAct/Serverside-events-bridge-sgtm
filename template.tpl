___SANDBOXED_JS_FOR_SERVER___

const getAllEventData = require('getAllEventData');
const sendHttpRequest = require('sendHttpRequest');
const JSON = require('JSON');
const Object = require('Object');
const getCookieValues = require('getCookieValues');
const getRequestHeader = require('getRequestHeader');
const getRemoteAddress = require('getRemoteAddress');
const getTimestampMillis = require('getTimestampMillis');
const generateRandom = require('generateRandom');
const encodeUriComponent = require('encodeUriComponent');
const decodeUriComponent = require('decodeUriComponent');
const makeNumber = require('makeNumber');
const makeString = require('makeString');
const getType = require('getType');
const log = require('logToConsole');
const Math = require('Math');
const sha256Sync = require('sha256Sync');

const ev = getAllEventData();

// ---------- helpers ----------
function isSet(v) { return v !== undefined && v !== null && v !== ''; }
function num(v) {
  if (!isSet(v)) return undefined;
  const n = makeNumber(v);
  if (n !== n) { // NaN
    log('WARN | Non-numeric value sent as is: ' + makeString(v));
    return v;
  }
  return n;
}
function pick(list) {
  for (let i = 0; i < list.length; i++) { if (isSet(list[i])) return list[i]; }
  return undefined;
}
function obj(v) { return getType(v) === 'object' ? v : {}; }
function firstCookie(name) {
  const v = getCookieValues(name);
  return (v && v.length) ? v[0] : undefined;
}
function splitList(s) {
  if (!isSet(s)) return [];
  const out = [];
  const parts = makeString(s).split(',');
  for (let i = 0; i < parts.length; i++) {
    const p = parts[i].trim();
    if (p) out.push(p);
  }
  return out;
}
function prune(v) {
  const t = getType(v);
  if (t === 'array') {
    const a = [];
    for (let i = 0; i < v.length; i++) { const p = prune(v[i]); if (p !== undefined) a.push(p); }
    return a.length ? a : undefined;
  }
  if (t === 'object') {
    const o = {};
    const keys = Object.keys(v);
    let n = 0;
    for (let i = 0; i < keys.length; i++) {
      const p = prune(v[keys[i]]);
      if (p !== undefined) { o[keys[i]] = p; n++; }
    }
    return n ? o : undefined;
  }
  return isSet(v) ? v : undefined;
}
// Hides the source key in URLs written to the logs
function redactToken(url) {
  const s = makeString(url);
  const i = s.indexOf('token=');
  if (i < 0) return s;
  const end = s.indexOf('&', i);
  return s.substring(0, i) + 'token=***' + (end < 0 ? '' : s.substring(end));
}

// ---------- ecommerce normalization ----------
const ec = obj(ev.ecommerce);
const UA_ACTIONS = ['purchase', 'refund', 'checkout', 'checkout_option', 'add', 'remove', 'detail', 'click'];
let uaAction = {};
for (let i = 0; i < UA_ACTIONS.length; i++) {
  if (getType(ec[UA_ACTIONS[i]]) === 'object') { uaAction = ec[UA_ACTIONS[i]]; break; }
}
const af = obj(uaAction.actionField);
const currency = pick([ev.currency, ec.currency, ec.currencyCode]);

function itemValue(it) {
  const p = num(it.price);
  const q = isSet(it.quantity) ? num(it.quantity) : 1;
  if (getType(p) !== 'number' || getType(q) !== 'number') return undefined;
  return Math.round(p * q * 100) / 100;
}

function mapItem(i) {
  const it = obj(i);
  const cats = getType(it.category) === 'string' ? it.category.split('/') : [];
  return {
    id: pick([it.item_id, it.id]),
    variant: pick([it.item_variant, it.variant]),
    quantity: num(it.quantity),
    value: itemValue(it),
    discount: num(it.discount),
    list_position: num(pick([it.index, it.position])),
    coupon: it.coupon,
    affiliation: it.affiliation,
    product: {
      id: pick([it.item_id, it.id]),
      name: pick([it.item_name, it.name]),
      price: num(it.price),
      currency: pick([it.currency, currency]),
      category_1: pick([it.item_category, cats[0]]),
      category_2: pick([it.item_category2, cats[1]]),
      category_3: pick([it.item_category3, cats[2]]),
      category_4: pick([it.item_category4, cats[3]]),
      category_5: pick([it.item_category5, cats[4]]),
      brand: pick([it.item_brand, it.brand])
    }
  };
}
const rawItems = pick([
  getType(ev.items) === 'array' ? ev.items : undefined,
  getType(ec.items) === 'array' ? ec.items : undefined,
  getType(uaAction.products) === 'array' ? uaAction.products : undefined,
  getType(ec.impressions) === 'array' ? ec.impressions : undefined
]);

// ---------- consent ----------
function consentFromVariable(v) {
  if (getType(v) === 'array') return v.map(function (c) { return makeString(c); });
  if (!isSet(v)) return undefined; // empty or missing = consent unknown, field not sent
  // "none" = every category refused, sent as an empty array
  if (makeString(v).trim().toLowerCase() === 'none') return [];
  return splitList(v);
}
// TC_PRIVACY: <status>@<versions|banner|site>@<categories>@<blocked_on>@<timestamps>[@...]
function consentFromCookie() {
  const raw = firstCookie(data.consentCookieName || 'TC_PRIVACY');
  if (!raw) return undefined;
  const parts = raw.split(data.consentCookieSeparator || '@');
  if (parts.length < 3) return undefined;
  const listed = splitList(decodeUriComponent(parts[2]) || '');
  const blockedOn = data.includeBlockedOn ? splitList(decodeUriComponent(parts[3] || '') || '') : [];
  if (parts[0] === '0') return listed.concat(blockedOn);
  if (parts[0] === '1') {
    if (!listed.length || listed.indexOf('ALL') > -1) return blockedOn;
    const all = splitList(data.allCategoryIds);
    if (!all.length) { log('WARN | TC_PRIVACY opt-out list but no allCategoryIds configured'); return undefined; }
    return all.filter(function (c) { return listed.indexOf(c) === -1; }).concat(blockedOn);
  }
  return undefined;
}
function consentCategories() {
  if (data.consentSource === 'variable') return consentFromVariable(data.consentCategories);
  if (data.consentSource === 'cookie') return consentFromCookie();
  return undefined;
}
function gcmFromGcs(gcs) {
  if (getType(gcs) !== 'string' || gcs.length < 4) return undefined;
  return {
    ad_storage: gcs.charAt(2) === '1' ? 'granted' : 'denied',
    analytics_storage: gcs.charAt(3) === '1' ? 'granted' : 'denied'
  };
}

// ---------- context helpers ----------
function viewport(v) {
  if (getType(v) !== 'string' || v.indexOf('x') === -1) return undefined;
  const wh = v.split('x');
  return { width: num(wh[0]), height: num(wh[1]) };
}
function cookieString() {
  if (!data.forwardCookies) return undefined;
  const names = ['_fbp', '_fbc', '_ga'];
  const parts = [];
  for (let i = 0; i < names.length; i++) {
    const v = firstCookie(names[i]);
    if (v) parts.push(names[i] + '=' + v);
  }
  return parts.length ? parts.join('; ') : undefined;
}

// ---------- user data ----------
function hashEmail(e) {
  if (!isSet(e)) return undefined;
  return sha256Sync(makeString(e).trim().toLowerCase(), { outputEncoding: 'hex' });
}
function userDataFields(ud, addr) {
  const mode = data.userDataMode || 'hashed'; // tags created before 0.9.1 default to hashed
  if (mode === 'none') return {};
  if (mode === 'raw') {
    return {
      email: ud.email_address,
      email_sha256: ud.sha256_email_address,
      phone: ud.phone_number,
      firstname: addr.first_name,
      lastname: addr.last_name,
      street: addr.street,
      city: addr.city,
      state: addr.region,
      zipcode: addr.postal_code,
      country: addr.country
    };
  }
  return { email_sha256: pick([ud.sha256_email_address, hashEmail(ud.email_address)]) };
}

// ---------- pass-through ----------
const MAPPED = ['event_name', 'event', 'ecommerce', 'items', 'user_data', 'user_id', 'client_id',
  'currency', 'value', 'transaction_id', 'tax', 'shipping', 'coupon', 'affiliation', 'event_id',
  'page_location', 'page_title', 'page_referrer', 'language', 'user_agent', 'ip_override',
  'viewport_size', 'page_type', 'payment_type', 'shipping_tier', 'search_term',
  'item_list_name', 'method', 'content_type', 'item_id'];
function passthrough() {
  if (!data.forwardUnmapped) return {};
  const exclude = splitList(data.excludeFields);
  const out = {};
  const keys = Object.keys(ev);
  for (let i = 0; i < keys.length; i++) {
    const k = keys[i];
    if (MAPPED.indexOf(k) > -1 || exclude.indexOf(k) > -1) continue;
    if (k.indexOf('x-') === 0 || k.indexOf('gtm.') === 0) continue;
    out[k] = ev[k];
  }
  return out;
}

// ---------- main ----------
function main() {
  const eventName = makeString(pick([data.eventNameOverride, ev.event_name, ev.event]) || '');
  if (!eventName || eventName === 'undefined') {
    log('INFO | No event name, nothing sent');
    return data.gtmOnSuccess();
  }
  if (data.skipGtmInternal !== false && eventName.indexOf('gtm.') === 0) {
    return data.gtmOnSuccess();
  }

  const ud = obj(ev.user_data);
  const addr = obj(getType(ud.address) === 'array' ? ud.address[0] : ud.address);
  const now = makeString(getTimestampMillis());

  const payload = passthrough();

  payload.event_name = eventName;
  payload.id = pick([ev.transaction_id, ec.transaction_id, af.id]);
  payload.value = num(pick([ev.value, ec.value, af.revenue]));
  payload.revenue = num(data.revenue);
  payload.currency = currency;
  payload.coupon = pick([ev.coupon, ec.coupon, af.coupon]);
  payload.affiliation = pick([ev.affiliation, ec.affiliation, af.affiliation]);
  payload.tax_amount = num(pick([ev.tax, ec.tax, af.tax]));
  payload.shipping_amount = num(pick([ev.shipping, ec.shipping, af.shipping]));
  payload.payment_method = pick([ev.payment_type, ec.payment_type]);
  payload.shipping_tier = pick([ev.shipping_tier, ec.shipping_tier]);
  payload.item_list_name = pick([ev.item_list_name, ec.item_list_name]);
  payload.search_term = ev.search_term;
  payload.method = ev.method;
  payload.content_type = ev.content_type;
  payload.item_id = ev.item_id;
  if (rawItems) payload.items = rawItems.map(mapItem);
  if (eventName === 'page_view') {
    const pt = pick([data.pageType, ev.page_type]);
    payload.page_type = pt;
    payload.type = pt;
  }

  payload.user = {
    id: ev.user_id,
    consistent_anonymous_id: pick([data.caidOverride, firstCookie('CAID')]),
    google_consent_mode: gcmFromGcs(ev['x-ga-gcs'])
  };
  const udf = userDataFields(ud, addr);
  const udKeys = Object.keys(udf);
  for (let i = 0; i < udKeys.length; i++) payload.user[udKeys[i]] = udf[udKeys[i]];

  payload.context = {
    event_id: pick([data.eventId, ev.event_id]) || now + makeString(generateRandom(100000, 999999)),
    event_timestamp: now,
    page: {
      url: ev.page_location,
      title: ev.page_title,
      referrer: ev.page_referrer,
      lang: ev.language,
      viewport: viewport(ev.viewport_size)
    },
    device: {
      user_agent: isSet(ev.user_agent) ? ev.user_agent : getRequestHeader('user-agent'),
      ip: isSet(ev.ip_override) ? ev.ip_override : getRemoteAddress(),
      lang: ev.language,
      cookie: cookieString()
    }
  };

  if (data.customFieldsTable) {
    for (let i = 0; i < data.customFieldsTable.length; i++) {
      payload[data.customFieldsTable[i].field_name] = data.customFieldsTable[i].field_value;
    }
  }

  const clean = prune(payload) || {};

  // Added after prune so an empty array ("everything refused") is kept.
  const consent = consentCategories();
  if (consent === undefined && data.consentSource !== 'none') {
    log('WARN | Consent source is ' + data.consentSource + ' but no consent categories were found; consent_categories not sent');
  }
  if (consent !== undefined) {
    clean.user = clean.user || {};
    clean.user.consent_categories = consent;
  }

  const body = JSON.stringify(clean);
  if (body.length > 32000) log('WARN | Payload above 32KB, the API will reject it (400)');

  const url = 'https://' + (data.collectionDomain || 'collect.commander1.com') +
    (data.collectionPath || '/events') +
    '?tc_s=' + encodeUriComponent(makeString(data.siteId)) +
    '&token=' + encodeUriComponent(data.sourceKey);

  // Follows one 307/308 redirect, only back to the same collection domain.
  const opts = { method: 'POST', headers: { 'Content-Type': 'application/json' }, timeout: 5000 };
  const host = 'https://' + (data.collectionDomain || 'collect.commander1.com') + '/';

  const send = function (target, redirects) {
    sendHttpRequest(target, function (statusCode, headers) {
      if (statusCode >= 200 && statusCode < 300) return data.gtmOnSuccess();
      const loc = headers ? (headers.location || headers.Location) : undefined;
      if ((statusCode === 307 || statusCode === 308) && redirects < 1 &&
          getType(loc) === 'string' && loc.indexOf(host) === 0) {
        log('INFO | Following redirect to ' + redactToken(loc));
        return send(loc, redirects + 1);
      }
      log('ERROR | Commanders Act returned ' + statusCode);
      data.gtmOnFailure();
    }, opts, body);
  };
  send(url, 0);
}

main();


