    assertThat(sentBody.user.consent_categories).isEqualTo(['1', '3']);
- name: Consent cookie status 1 opt out list
  code: |-
    eventData = { event_name: 'page_view' };
    mockData.consentSource = 'cookie';
    mockData.allCategoryIds = '1,2,3';
    cookies.TC_PRIVACY = '1@033|5|3311@2@@1700000000000,1700000000000,1733000000000';
    runCode(mockData);
    assertThat(sentBody.user.consent_categories).isEqualTo(['1', '3']);
- name: Consent cookie status 1 empty list kept
  code: |-
    eventData = { event_name: 'page_view' };
    mockData.consentSource = 'cookie';
    cookies.TC_PRIVACY = '1@033|5|3311@@@1700000000000,1700000000000,1733000000000';
    runCode(mockData);
    assertThat(sentBody.user.consent_categories).isEqualTo([]);
- name: Pass through with exclusions and GCS
  code: |-
    eventData = {
      event_name: 'sign_up', method: 'google', email: 'a@b.c',
      'x-ga-gcs': 'G111', 'gtm.uniqueEventId': 1
    };
    mockData.forwardUnmapped = true;
    mockData.excludeFields = 'email';
    runCode(mockData);
    assertThat(sentBody.method).isEqualTo('google');
    assertThat(sentBody.email).isUndefined();
    assertThat(sentBody['x-ga-gcs']).isUndefined();
