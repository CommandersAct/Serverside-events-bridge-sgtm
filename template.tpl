- name: Missing consent logs a warning
  code: |-
    eventData = { event_name: 'page_view' };
    mockData.consentSource = 'variable';
    mockData.consentCategories = '';
    const logs = [];
    mock('logToConsole', function (msg) { logs.push(msg); });
    runCode(mockData);
    assertThat(sentBody.user.consent_categories).isUndefined();
    assertThat(logs.join(' | ')).contains('no consent categories were found');
- name: Redirect to another host is not followed
  code: |-
    eventData = { event_name: 'page_view' };
    redirectTo = 'https://other.example.net/events?token=abc-key';
    runCode(mockData);
    assertThat(calls).isEqualTo(1);
    assertApi('gtmOnFailure').wasCalled();
- name: Redirect log hides the token
  code: |-
    eventData = { event_name: 'page_view' };
    redirectTo = 'https://collect.commander1.com/events?tc_firsttime=1&tc_s=1234&token=SECRET123';

    const logs = [];
    mock('logToConsole', function (msg) { logs.push(msg); });

    runCode(mockData);

    // redirect still followed with the real token
    assertThat(calls).isEqualTo(2);
    assertThat(sentUrl).isEqualTo(redirectTo);

    // token hidden in the logs
    const allLogs = logs.join(' | ');
    assertThat(allLogs).contains('token=***');
    assertThat(allLogs).doesNotContain('SECRET123');

    assertApi('gtmOnSuccess').wasCalled();
setup: |-
  const JSON = require('JSON');
  const mockData = {
    siteId: '1234',
    sourceKey: 'abc-key',
    forwardUnmapped: false,
    skipGtmInternal: true,
    consentSource: 'none'
  };
  let eventData = {};
  let cookies = { CAID: 'caid-1' };
  let statusCode = 200;
  let sentUrl;
  let sentBody;
  mock('getAllEventData', () => eventData);
  mock('getCookieValues', (name) => cookies[name] ? [cookies[name]] : []);
  mock('getRequestHeader', (name) => (name && name.toLowerCase() === 'user-agent') ? 'Mozilla/5.0 test' : undefined);
  mock('getRemoteAddress', () => '203.0.113.10');
  let calls = 0;
  let redirectTo;
  mock('sendHttpRequest', (url, callback, options, body) => {
    calls++;
    sentUrl = url;
    sentBody = JSON.parse(body);
    if (redirectTo && calls === 1) return callback(307, { location: redirectTo });
    callback(statusCode, {});
  });
  mock('sha256Sync', (s) => 'hash:' + s);


___NOTES___

v0.9.1-beta (2026-11-23)
- Numeric fields: non-numeric values are sent as received instead of null, so Data Quality can flag them
- Consent: Consent categories field required in Variable mode; warning logged when no consent is found
- User data: new setting, default "Email hashed (SHA-256) only"
- Logs: the source key is hidden in the redirect log line (token=***)

