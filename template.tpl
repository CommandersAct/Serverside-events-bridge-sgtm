___TESTS___

scenarios:
- name: Common event data page view
  code: |-
    eventData = {
      event_name: 'page_view',
      page_location: 'https://www.example.com/',
      page_title: 'Home',
      language: 'fr-fr',
      viewport_size: '1280x720',
      ip_override: '198.51.100.1',
      client_id: '123.456'
    };
    mockData.pageType = 'home';
    runCode(mockData);
    assertApi('gtmOnSuccess').wasCalled();
    assertThat(sentUrl).isEqualTo('https://collect.commander1.com/events?tc_s=1234&token=abc-key');
    assertThat(sentBody.event_name).isEqualTo('page_view');
    assertThat(sentBody.page_type).isEqualTo('home');
    assertThat(sentBody.context.page.viewport.width).isEqualTo(1280);
    assertThat(sentBody.context.device.ip).isEqualTo('198.51.100.1');
    assertThat(sentBody.context.device.user_agent).isEqualTo('Mozilla/5.0 test');
    assertThat(sentBody.user.consistent_anonymous_id).isEqualTo('caid-1');
    assertThat(sentBody.client_id).isUndefined();
- name: DataLayer ecommerce items purchase
  code: |-
    eventData = {
      event_name: 'purchase',
      ecommerce: {
        transaction_id: 'T1', value: 120, tax: 20, shipping: 5, currency: 'EUR', payment_type: 'card',
        items: [{ item_id: 'SKU1', item_name: 'Shirt', price: '50', quantity: 2,
          item_category: 'Men', item_category2: 'Shirts', index: 1 }]
      }
    };
    mockData.revenue = '95';
    runCode(mockData);
    assertThat(sentBody.id).isEqualTo('T1');
    assertThat(sentBody.value).isEqualTo(120);
    assertThat(sentBody.revenue).isEqualTo(95);
    assertThat(sentBody.tax_amount).isEqualTo(20);
    assertThat(sentBody.shipping_amount).isEqualTo(5);
    assertThat(sentBody.items[0].product.price).isEqualTo(50);
    assertThat(sentBody.items[0].product.currency).isEqualTo('EUR');
    assertThat(sentBody.items[0].product.category_2).isEqualTo('Shirts');
    assertThat(sentBody.items[0].list_position).isEqualTo(1);
    assertThat(sentBody.items[0].value).isEqualTo(100);
    assertThat(sentBody.payment_method).isEqualTo('card');
- name: UA ecommerce purchase products
  code: |-
    eventData = {
      event: 'purchase',
      ecommerce: {
        currencyCode: 'EUR',
        purchase: {
          actionField: { id: 'T2', revenue: '80', tax: '10', shipping: '4', coupon: 'WELCOME' },
          products: [{ id: 'SKU2', name: 'Shoes', price: '70', quantity: 1,
            category: 'Men/Shoes/Sneakers', brand: 'Acme', position: 3 }]
        }
      }
    };
    runCode(mockData);
    assertThat(sentBody.event_name).isEqualTo('purchase');
    assertThat(sentBody.id).isEqualTo('T2');
    assertThat(sentBody.value).isEqualTo(80);
    assertThat(sentBody.coupon).isEqualTo('WELCOME');
    assertThat(sentBody.currency).isEqualTo('EUR');
    assertThat(sentBody.items[0].product.category_3).isEqualTo('Sneakers');
    assertThat(sentBody.items[0].product.brand).isEqualTo('Acme');
    assertThat(sentBody.items[0].list_position).isEqualTo(3);
- name: Consent variable mode
  code: |-
    eventData = { event_name: 'page_view' };
    mockData.consentSource = 'variable';
    mockData.consentCategories = '1, 4';
    runCode(mockData);
    assertThat(sentBody.user.consent_categories).isEqualTo(['1', '4']);
- name: Consent variable none means all refused
  code: |-
    eventData = { event_name: 'page_view' };
    mockData.consentSource = 'variable';
    mockData.consentCategories = 'none';
    runCode(mockData);
    assertThat(sentBody.user.consent_categories).isEqualTo([]);
- name: Consent variable empty value is omitted
  code: |-
